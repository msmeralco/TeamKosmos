# Copy to backend/.env (gitignored) and fill in. Never commit real keys.

# --- Gemini ---------------------------------------------------------
GEMINI_API_KEY=
# Run `python scripts/verify_gemini.py` to find a model that supports image input + function calling on your key.
GEMINI_MODEL=gemini-3.8-flash
# Tried when the main model is overloaded (503) or times out, before the built-in rule-based agent. Empty disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# auto = use Gemini when a key exists, fall back to the scripted agent on errors. scripted = never call Gemini.
AGENT_MODE=auto

# --- Database -------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> Session pooler (IPv4). Include the password.
DATABASE_URL=
# auto = try Supabase, fall back to local SQLite. sqlite = always local. supabase = prefer Supabase.
DB_BACKEND=auto

# --- Public APIs ----------------------------------------------------
# Placeholder on purpose: Nominatim/Overpass require a real contact in the User-Agent.
CONTACT_EMAIL=your-email@example.com
# Set to 0 to skip live PVGIS calls and use the bundled approximate typical year.
PVGIS_LIVE=1

# --- Frontend -------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
